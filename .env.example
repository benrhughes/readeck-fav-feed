# Readeck API Configuration
# Required: Your Readeck API token (https://readeck.local/profile/tokens)
READECK_TOKEN=your-api-token-here

# Optional: Readeck API URL (defaults to http://localhost:8000/api)
# READECK_URL=http://readeck.example.com/api

# Optional: Server port (defaults to 3000)
# PORT=3000

# Optional: Cache TTL in seconds (defaults to 300)
# CACHE_TTL_SECONDS=300

# Optional: Feed metadata
# FEED_TITLE=My Readeck Favourites
# FEED_DESCRIPTION=A feed of my bookmarked articles from Readeck
# FEED_LINK=https://readeck.local
